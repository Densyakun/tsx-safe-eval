{
  "name": "tsx-safe-eval",
  "version": "1.0.0",
  "description": "Safe evaluation of TSX code strings using ts-morph",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "i-want-to-go-home": "^0.1.0",
    "normalize-path": "^3.0.0",
    "strip-json-comments": "^5.0.3",
    "ts-morph": "^25.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/normalize-path": "^3.0.2",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "tsx",
    "eval",
    "safe",
    "interpreter",
    "ts-morph"
  ],
  "author": "",
  "license": "MIT"
}
